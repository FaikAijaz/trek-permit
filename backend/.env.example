NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/trekpermit

JWT_SECRET=
JWT_EXPIRES_IN=7d

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=3          # max OTP requests per mobile number per window
OTP_REQUEST_WINDOW_MINUTES=10

SMS_PROVIDER=console          # console | msg91 | twilio
SMS_API_KEY=

SIGNING_PRIVATE_KEY=          # dev only — managed key store in production
SIGNING_PUBLIC_KEY=

STORAGE_PROVIDER=local        # local | s3
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
